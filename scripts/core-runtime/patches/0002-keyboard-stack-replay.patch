+/// Local opt-in replay API: primary then alternate, each [index, flags x 8].
+/// Fixed-size v1 output; no allocation or mutation of either screen.
+pub fn keyboard_stacks_v1(terminal_: Terminal, out: *[18]u8) callconv(lib.calling_conv) void {
+    @memset(out, 0);
+    const wrapper = terminal_ orelse return;
+    for ([_]ScreenSet.Key{ .primary, .alternate }, 0..) |key, index| {
+        const screen = wrapper.terminal.screens.get(key) orelse continue;
+        comptime std.debug.assert((kitty.FlagStack{}).flags.len == 8);
+        out[index * 9] = screen.kitty_keyboard.idx;
+        for (screen.kitty_keyboard.flags, 0..) |flags, n| out[index * 9 + 1 + n] = flags.int();
+    }
+}
