+//! Bounded Kitty flag-ring replay, including entries retained after overflow.
+fn number(out: &mut Vec<u8>, value: u8) {
+    if value >= 10 {
+        out.push(b'0' + value / 10);
+    }
+    out.push(b'0' + value % 10);
+}
+fn push(out: &mut Vec<u8>, flags: u8) {
+    out.extend_from_slice(b"\x1b[>");
+    number(out, flags);
+    out.push(b'u');
+}
+pub(super) fn restore(out: &mut Vec<u8>, state: &[u8; 9]) {
+    let current = usize::from(state[0]);
+    let flags = &state[1..];
+    out.extend_from_slice(b"\x1b[<8u\x1b[=");
+    number(out, flags[0]);
+    out.extend_from_slice(b";1u");
+    let last = if flags[current + 1..].iter().any(|f| *f != 0) { flags.len() - 1 } else { current };
+    for flags in &flags[1..last + 1] {
+        push(out, *flags);
+    }
+    if last > current {
+        // A pop would erase live entries above the current index. Wrap through
+        // the ring with matching pushes instead, restoring every retained slot.
+        for flags in &flags[..current + 1] {
+            push(out, *flags);
+        }
+    }
+}
