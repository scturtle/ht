+use super::*;
+
+fn flags(terminal: &mut Terminal) -> Vec<u8> {
+    terminal.take_responses();
+    terminal.write(b"\x1b[?u");
+    terminal.take_responses()
+}
+
+#[test]
+fn kitty_keyboard_paint_preserves_stack_in_fresh_and_dirty_viewers_including_overflow() {
+    for pushes in [0, 2, 7, 10] {
+        let mut original = Terminal::new(40, 10, 0);
+        original.write(b"\x1b[=1;1u");
+        for n in 0..pushes {
+            original.write(format!("\x1b[>{}u", (n * 3 + 5) % 32).as_bytes());
+        }
+        let snapshot = original.snapshot().unwrap();
+        for dirty in [false, true] {
+            let mut source = Terminal::restore(&snapshot, 0).unwrap();
+            let mut viewer = Terminal::new(40, 10, 0);
+            if dirty {
+                viewer.write(b"\x1b[=31;1u\x1b[>7u\x1b[>3u\x1b[>9u");
+            }
+            viewer.write(&source.paint(0));
+            for pop in 0..10 {
+                assert_eq!(flags(&mut viewer), flags(&mut source), "pushes={pushes} dirty={dirty} after_pops={pop}");
+                viewer.write(b"\x1b[<u");
+                source.write(b"\x1b[<u");
+            }
+        }
+    }
+}
+
+#[test]
+fn kitty_keyboard_paint_preserves_inactive_screen_stack_across_later_screen_switches() {
+    for active_alt in [false, true] {
+        let mut source = Terminal::new(40, 10, 0);
+        source.write(b"\x1b[=1;1u\x1b[>3u\x1b[>5u\x1b[?1049h\x1b[=7;1u\x1b[>9u\x1b[>17u");
+        if !active_alt {
+            source.write(b"\x1b[?1049l");
+        }
+        let mut viewer = Terminal::new(40, 10, 0);
+        viewer.write(b"\x1b[=31;1u\x1b[>15u\x1b[?1049h\x1b[=25;1u\x1b[>30u");
+        viewer.write(&source.paint(0));
+        assert_eq!(viewer.alt_screen(), source.alt_screen());
+        for change in [
+            b"".as_slice(),
+            b"\x1b[<u",
+            b"\x1b[?1049l",
+            b"\x1b[<u",
+            b"\x1b[<u",
+            b"\x1b[?1049h",
+            b"\x1b[<u",
+            b"\x1b[<2u",
+            b"\x1b[?1049l",
+        ] {
+            source.write(change);
+            viewer.write(change);
+            assert_eq!(flags(&mut source), flags(&mut viewer), "active_alt={active_alt} change={change:?}");
+        }
+    }
+}
+
+#[test]
+fn kitty_keyboard_binary_snapshot_retains_both_screen_stacks_and_future_pops() {
+    let mut source = Terminal::new(40, 10, 0);
+    source.write(b"\x1b[=1;1u\x1b[>3u\x1b[>5u\x1b[?1049h\x1b[=7;1u\x1b[>9u\x1b[>17u");
+    let mut restored = Terminal::restore(&source.snapshot().unwrap(), 0).unwrap();
+    for change in [b"".as_slice(), b"\x1b[<u", b"\x1b[?1049l", b"\x1b[<u", b"\x1b[<u", b"\x1b[?1049h", b"\x1b[<u"] {
+        source.write(change);
+        restored.write(change);
+        assert_eq!(flags(&mut source), flags(&mut restored));
+    }
+}
