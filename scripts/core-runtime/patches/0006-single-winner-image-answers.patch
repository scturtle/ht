+/// Explicit AUTOMATIC_INPUT is framed independently of human/legacy DATA.
+/// A fragmented response is atomic; it never holds a person's Escape or paste.
+#[derive(Default)]
+struct Automatic {
+    held: Vec<u8>,
+    opaque: bool,
+    previous: u8,
+}
+
+pub(crate) struct AutomaticInput {
+    pub(crate) bytes: Vec<u8>,
+    pub(crate) query: Option<u64>,
+}
+
+impl Automatic {
+    fn feed(&mut self, input: &[u8]) -> Vec<(bool, Vec<u8>)> {
+        const PREFIX: &[u8] = b"\x1b_G";
+        const LIMIT: usize = 512;
+        let mut output = Vec::new();
+        let mut plain = Vec::new();
+        for &byte in input {
+            if self.opaque {
+                plain.push(byte);
+                if self.previous == 0x1b && byte == b'\\' {
+                    self.opaque = false;
+                }
+                self.previous = byte;
+                continue;
+            }
+            if self.held.is_empty() && byte != 0x1b {
+                plain.push(byte);
+                continue;
+            }
+            self.held.push(byte);
+            if self.held.len() <= PREFIX.len() && !PREFIX.starts_with(&self.held) {
+                // ESC ESC can end one sequence and begin the next.
+                if byte == 0x1b {
+                    plain.extend_from_slice(&self.held[..self.held.len() - 1]);
+                    self.held.clear();
+                    self.held.push(byte);
+                } else {
+                    plain.append(&mut self.held);
+                }
+            } else if self.held.len() > PREFIX.len() && self.held.ends_with(b"\x1b\\") {
+                if !plain.is_empty() {
+                    output.push((false, std::mem::take(&mut plain)));
+                }
+                output.push((true, std::mem::take(&mut self.held)));
+            } else if self.held.len() == LIMIT {
+                // Do not guess about oversized/malformed replies, nor buffer an
+                // unbounded body. Pass it unchanged through its terminator.
+                plain.append(&mut self.held);
+                self.opaque = true;
+                self.previous = byte;
+            }
+        }
+        if !plain.is_empty() {
+            output.push((false, plain));
+        }
+        output
+    }
+}
+
+fn response_key(sequence: &[u8]) -> Option<Key> {
+    let original = sequence;
+    let sequence = sequence.strip_prefix(b"\x1b_G")?.strip_suffix(b"\x1b\\")?;
+    let at = sequence.iter().position(|b| *b == b';')?;
+    let (header, body) = (&sequence[..at], &sequence[at + 1..]);
+    let error = body.iter().position(|b| *b == b':').is_some_and(|at| {
+        at > 1 && body[0] == b'E' && body[..at].iter().all(|b| b.is_ascii_uppercase() || b.is_ascii_digit())
+    });
+    if body != b"OK" && !error {
+        return None;
+    }
+    let mut seen = 0u8;
+    for field in header.split(|b| *b == b',') {
+        let bit = match field.first()? {
+            b'i' => 1,
+            b'I' => 2,
+            b'p' => 4,
+            _ => return None,
+        };
+        if seen & bit != 0
+            || field.get(1) != Some(&b'=')
+            || field.len() < 3
+            || !field[2..].iter().all(u8::is_ascii_digit)
+        {
+            return None;
+        }
+        seen |= bit;
+    }
+    key(original)
+}
