+//! The opt-in interactive stream contract; legacy attach retains its old behavior.
+use super::*;
+use crate::wire;
+
+fn fixture() -> (Arc<Core>, u32, std::path::PathBuf) {
+    let root = std::path::PathBuf::from(format!("/var/tmp/hc-ordered-{}", crate::platform::random_hex()));
+    let paths = crate::paths::Paths {
+        socket: root.join("core.sock"),
+        holder_socket: root.join("holder.sock"),
+        state: root.clone(),
+        config: root.join("config.toml"),
+    };
+    paths.create_dirs().unwrap();
+    let core =
+        Core::start(paths, crate::api::CoreInfo { id: "ordered-test".into(), name: "ordered-test".into() }).unwrap();
+    let id = {
+        let mut st = core.lock();
+        let id = st
+            .reg
+            .create(
+                crate::terminals::NewTerminal { argv: vec!["sh".into()], cols: 80, rows: 24, ..Default::default() },
+                0,
+            )
+            .unwrap();
+        st.screens.insert(id, ghostty_vt::Terminal::new(80, 24, 1 << 20));
+        id
+    };
+    (core, id, root)
+}
+fn request(size: (u16, u16), resumed: bool) -> AttachRequest {
+    AttachRequest {
+        observe: false,
+        resize_notifications: false,
+        history: 0,
+        size,
+        display: Display::default(),
+        resumed,
+    }
+}
+fn drain(conn: &Arc<Conn>, channel: u32) -> Vec<Vec<u8>> {
+    let mut frames = Vec::new();
+    conn.with(|out| {
+        out.resume(channel);
+        while let Some(frame) = out.next_frame() {
+            frames.push(frame);
+        }
+        for frame in &frames {
+            if frame[4] == wire::DATA {
+                out.credit(channel, frame.len() - wire::HEADER);
+            }
+        }
+    });
+    frames
+}
+fn resized(frames: &[Vec<u8>], size: (u16, u16)) {
+    assert_eq!(frames[0][4], wire::RESIZE);
+    assert_eq!(&frames[0][wire::HEADER..], &[size.0.to_le_bytes(), size.1.to_le_bytes()].concat());
+    assert_eq!(frames[1][4], wire::DATA);
+    assert_eq!(frames[1][wire::HEADER], 0x18, "replacement paint must precede any live bytes");
+}
+
+#[test]
+fn ordered_interactive_attach_fences_paints_through_leader_focus_input_detach_and_resume() {
+    let (core, id, root) = fixture();
+    let a = Arc::new(Conn::default());
+    let b = Arc::new(Conn::default());
+    let ca = core.attach_ordered(&a, id, request((80, 24), false)).unwrap();
+    resized(&drain(&a, ca), (80, 24));
+    let cb = core.attach_ordered(&b, id, request((50, 12), false)).unwrap();
+    resized(&drain(&b, cb), (50, 12));
+    core.output(&mut core.lock(), id, b"ORDERED_LIVE\r\n");
+    core.prepare_repaints(&a);
+    resized(&drain(&a, ca), (50, 12));
+    drain(&b, cb);
+    core.viewer_input(&a, ca, b"automatic", true);
+    assert_eq!(core.lock().reg.terminals[&id].cols, 50, "automatic replies must not steal leadership");
+    core.viewer_focus(&a, ca, true);
+    core.prepare_repaints(&a);
+    core.prepare_repaints(&b);
+    resized(&drain(&a, ca), (80, 24));
+    resized(&drain(&b, cb), (80, 24));
+    core.detach(&a, Some(ca));
+    core.prepare_repaints(&b);
+    resized(&drain(&b, cb), (50, 12));
+    let c = Arc::new(Conn::default());
+    let cc = core.attach_ordered(&c, id, request((97, 33), true)).unwrap();
+    resized(&drain(&c, cc), (50, 12));
+    assert_eq!(core.lock().reg.terminals[&id].cols, 50, "resumed viewers do not steal leadership");
+    core.viewer_input(&c, cc, b"human", false);
+    core.prepare_repaints(&b);
+    core.prepare_repaints(&c);
+    resized(&drain(&b, cb), (97, 33));
+    resized(&drain(&c, cc), (97, 33));
+    let legacy = Arc::new(Conn::default());
+    let old = core.attach(&legacy, id, request((22, 8), false)).unwrap();
+    assert!(drain(&legacy, old).iter().all(|f| f[4] != wire::RESIZE), "legacy interactive attach is unchanged");
+    drop(core);
+    std::fs::remove_dir_all(root).unwrap();
+}
+
+#[test]
+fn ordered_resumed_only_viewer_preserves_current_grid_until_explicit_activity() {
+    let (core, id, root) = fixture();
+    let conn = Arc::new(Conn::default());
+    let channel = core.attach_ordered(&conn, id, request((97, 33), true)).unwrap();
+    resized(&drain(&conn, channel), (80, 24));
+    core.viewer_facts(&conn, channel, Display::default());
+    assert_eq!(core.lock().reg.terminals[&id].cols, 80);
+    core.viewer_input(&conn, channel, b"automatic", true);
+    assert_eq!(core.lock().reg.terminals[&id].cols, 80);
+    core.viewer_focus(&conn, channel, true);
+    core.prepare_repaints(&conn);
+    resized(&drain(&conn, channel), (97, 33));
+    drop(core);
+    std::fs::remove_dir_all(root).unwrap();
+}
+
+#[test]
+fn ordered_interactive_stalled_resizes_coalesce_without_serializing_obsolete_paints() {
+    let (core, id, root) = fixture();
+    let conn = Arc::new(Conn::default());
+    let channel = core.attach_ordered(&conn, id, request((80, 24), false)).unwrap();
+    drain(&conn, channel);
+    conn.with(|out| {
+        out.data(channel, &vec![b'x'; wire::WINDOW]);
+        while out.next_frame().is_some() {}
+    });
+    super::tests::PAINTS.set(0);
+    for cols in 100..200 {
+        core.viewer_resize(&conn, channel, cols, 24);
+        core.prepare_repaints(&conn);
+    }
+    core.output(&mut core.lock(), id, b"LATEST_GRID\r\n");
+    assert_eq!(super::tests::PAINTS.get(), 0);
+    conn.with(|out| {
+        assert_eq!(out.queued(channel), 0);
+        assert!(out.next_frame().is_none());
+        out.credit(channel, wire::WINDOW);
+    });
+    core.prepare_repaints(&conn);
+    resized(&drain(&conn, channel), (199, 24));
+    assert_eq!(super::tests::PAINTS.get(), 1);
+    core.prepare_repaints(&conn);
+    assert_eq!(super::tests::PAINTS.get(), 1);
+    drop(core);
+    std::fs::remove_dir_all(root).unwrap();
+}
