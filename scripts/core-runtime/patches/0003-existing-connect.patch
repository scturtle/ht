+
+#[test]
+fn existing_connect_never_starts_or_resurrects_a_stopped_core() {
+    let s = Session::new();
+    let hello = b"{\"jsonrpc\":\"2.0\",\"id\":0,\"method\":\"hello\",\"params\":{\"generation\":1}}\n";
+    let missing = s.hc_input(&["connect", "--existing"], hello);
+    assert!(!missing.status.success());
+    assert!(!s.socket().exists());
+    let error: Value = serde_json::from_slice(&missing.stderr).unwrap();
+    assert_eq!(error["error"]["kind"], "unavailable");
+
+    let status = s.json(&["server", "status"]);
+    let pid = status["pid"].as_i64().unwrap();
+    let reply = s.hc_input(&["connect", "--existing"], hello);
+    assert!(reply.status.success(), "{}", String::from_utf8_lossy(&reply.stderr));
+    let reply: Value = serde_json::from_slice(&reply.stdout).unwrap();
+    assert!(reply["result"]["features"].as_array().unwrap().iter().any(|f| f == "existing_connect"));
+    assert_eq!(s.json(&["server", "status"])["pid"], pid);
+
+    s.json(&["server", "stop"]);
+    wait_until("core stopped", || !pid_alive(pid));
+    let stopped = s.hc_input(&["connect", "--existing"], hello);
+    assert!(!stopped.status.success());
+    assert!(!s.socket().exists(), "a reconnect probe must not undo explicit stop");
 }
 
