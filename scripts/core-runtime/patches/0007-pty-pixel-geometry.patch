--- /dev/null
+++ b/crates/herdr-core/tests/pty_pixels.rs
@@ -0,0 +1,69 @@
+#![cfg(target_os = "linux")]
+mod common;
+
+use common::framed::Viewer;
+use common::*;
+use herdr_core::wire;
+use serde_json::json;
+
+#[test]
+fn pty_ioctl_pixels_follow_only_the_size_leader() {
+    let s = Session::new();
+    let log = s.root.join("winsize.json");
+    let program = executable(
+        &s,
+        &format!(
+            r#"#!/usr/bin/env python3
+import fcntl,json,os,struct,termios,time
+from pathlib import Path
+out=Path({log:?})
+tmp=out.with_suffix('.pending')
+os.write(1,b'PIXELS_READY')
+while True:
+    size=struct.unpack('HHHH',fcntl.ioctl(0,termios.TIOCGWINSZ,b'\0'*8))
+    tmp.write_text(json.dumps(size));tmp.replace(out)
+    time.sleep(.01)
+"#,
+            log = log.to_str().unwrap()
+        ),
+    );
+    let t = run(&s, &[&program]);
+    let expect = |rows, cols, width, height| {
+        wait_until("PTY ioctl geometry", || {
+            std::fs::read(&log).ok().and_then(|b| serde_json::from_slice::<serde_json::Value>(&b).ok())
+                == Some(json!([rows, cols, width, height]))
+        });
+    };
+    let facts = |viewer: &mut Viewer, cell| {
+        viewer.conn.send(viewer.channel, wire::FACTS, &serde_json::to_vec(&json!({"cell": cell})).unwrap());
+        viewer.conn.call("terminal.get", json!({"terminal": t}));
+    };
+    let mut a = Viewer::attach(&s, &t, 80, 24, json!({"display":{"cell":[8,16]}}));
+    a.shows("PIXELS_READY");
+    expect(24, 80, 640, 384);
+    // Same grid, different client/cell pixels must still update the PTY.
+    let mut b = Viewer::attach(&s, &t, 80, 24, json!({"display":{"cell":[10,20]}}));
+    b.shows("PIXELS_READY");
+    expect(24, 80, 800, 480);
+    facts(&mut a, [9, 18]);
+    b.conn.send(b.channel, wire::AUTOMATIC_INPUT, b"\x1b[0n");
+    expect(24, 80, 800, 480);
+    facts(&mut b, [12, 24]);
+    expect(24, 80, 960, 576);
+    a.conn.send(a.channel, wire::FOCUS, &[1]);
+    expect(24, 80, 720, 432);
+    b.typed(b"x");
+    expect(24, 80, 960, 576);
+    b.conn.send(b.channel, wire::RESIZE, &[100, 0, 30, 0]);
+    expect(30, 100, 1200, 720);
+    facts(&mut b, [u32::MAX, u32::MAX]);
+    expect(30, 100, 65535, 65535);
+    facts(&mut b, [0, 24]);
+    expect(30, 100, 0, 0);
+    // An observer's display facts never replace a typing client's geometry.
+    let mut observer = Viewer::attach(&s, &t, 50, 10, json!({"observe":true,"display":{"cell":[2,3]}}));
+    facts(&mut observer, [3, 4]);
+    expect(30, 100, 0, 0);
+    drop(b);
+    expect(24, 80, 720, 432);
+}
